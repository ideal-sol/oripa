# HTTPS server include. Substitute __PAIDY_TOKEN__ privately; never commit it.
# Keep the 503 until the redacted API, ENV and Runtime have separate Human GO.
location = /webhooks/v2/paidy/__PAIDY_TOKEN__ {
    access_log off;
    error_log /dev/null;
    auth_basic off;
    limit_except POST { deny all; }
    return 503;
    proxy_pass http://127.0.0.1:8621;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Wrong/extra path components never reach either upstream.
location ^~ /webhooks/v2/paidy/ {
    access_log off;
    error_log /dev/null;
    return 404;
}
