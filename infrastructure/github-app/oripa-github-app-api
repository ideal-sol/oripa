#!/usr/bin/env python3
"""Read-only GitHub App API wrapper, including verified Preview artifacts."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import runpy
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import zipfile


BROKER = "/usr/local/libexec/ideal-sol-github-app-token"
API_ROOT = "https://api.github.com"
API_VERSION = "2022-11-28"
USER_AGENT = "ideal-sol-github-app-api/1.1"
REPOSITORY = "ideal-sol/oripa"
POLICY_DIRECTORY = Path("/etc/ideal-sol/github-app/task-policies")
EVIDENCE_ROOT = Path("/var/lib/oripa-v2-evidence")
ARTIFACT_HELPER = Path("/var/www/oripa/scripts/ops/preview_image_artifact.py")
MAX_POLICY_BYTES = 32768
MAX_ARTIFACT_BYTES = 2 * 1024 * 1024 * 1024
OPERATIONS = {
    "repository": "/repos/ideal-sol/oripa",
    "main-branch": "/repos/ideal-sol/oripa/branches/main",
    "archive-branch": "/repos/ideal-sol/oripa/branches/archive%2Fv1-current",
}
JOB_ID = re.compile(r"[1-9][0-9]{0,19}")
ARTIFACT_ID = re.compile(r"[1-9][0-9]{0,19}")
PR_NUMBER = re.compile(r"[1-9][0-9]{0,9}")
FULL_SHA = re.compile(r"[0-9a-f]{40}")
SHA256 = re.compile(r"sha256:([0-9a-f]{64})")
TASK_ID = re.compile(r"[A-Z][A-Z0-9-]{2,31}")
REQUIRED_CHECKS = {
    "policy-gate",
    "quality-gate",
    "security-gate",
    "integration-gate",
    "ci-gate",
}
CHECK_RUN_GATE = runpy.run_path(str(Path(__file__).with_name("check_run_gate.py")))
REDACTIONS = (
    re.compile(r"(?i)(authorization|token|password|secret)([=:]\\s*)[^\\s]+"),
    re.compile(r"gh[pousr]_[A-Za-z0-9_]{20,}"),
    re.compile(r"github_pat_[A-Za-z0-9_]{20,}"),
    re.compile(r"AKIA[0-9A-Z]{16}"),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
)


class WrapperError(Exception):
    pass


def fail(message: str) -> None:
    raise WrapperError(message)


def broker_call(arguments: list[str]) -> str:
    result = subprocess.run(
        [BROKER] + arguments,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
        text=True,
    )
    if result.returncode != 0 or not result.stdout:
        fail("broker_failed")
    return result.stdout.strip()


def installation_token() -> str:
    value = broker_call([])
    if len(value) < 20:
        fail("broker_token_invalid")
    return value


def github_request(path: str, *, accept: str = "application/vnd.github+json"):
    if not path.startswith("/") or ".." in path or "://" in path:
        fail("github_path_invalid")
    access_token = installation_token()
    request = urllib.request.Request(
        API_ROOT + path,
        method="GET",
        headers={
            "Accept": accept,
            "Authorization": f"Bearer {access_token}",
            "X-GitHub-Api-Version": API_VERSION,
            "User-Agent": USER_AGENT,
        },
    )
    try:
        return urllib.request.urlopen(request, timeout=60)
    except urllib.error.HTTPError as error:
        error.read()
        fail(f"github_api_http_{error.code}")
    except (urllib.error.URLError, TimeoutError):
        fail("github_api_connection_failed")
    finally:
        access_token = ""


def api_get(path: str):
    with github_request(path) as response:
        body = response.read()
    try:
        return json.loads(body.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError):
        fail("github_api_response_invalid")


def api_get_bytes(path: str) -> bytes:
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, request, file_pointer, code, message, headers, url):
            return None

    access_token = installation_token()
    request = urllib.request.Request(
        API_ROOT + path,
        method="GET",
        headers={
            "Accept": "application/vnd.github+json",
            "Authorization": f"Bearer {access_token}",
            "X-GitHub-Api-Version": API_VERSION,
            "User-Agent": USER_AGENT,
        },
    )
    try:
        urllib.request.build_opener(NoRedirect).open(request, timeout=30)
        fail("github_redirect_missing")
    except urllib.error.HTTPError as error:
        if error.code not in {301, 302, 303, 307, 308}:
            error.read()
            fail(f"github_api_http_{error.code}")
        location = error.headers.get("Location")
        if not location or not location.startswith("https://"):
            fail("github_redirect_invalid")
    except (urllib.error.URLError, TimeoutError):
        fail("github_api_connection_failed")
    finally:
        access_token = ""
    try:
        with urllib.request.urlopen(location, timeout=30) as response:
            return response.read()
    except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError):
        fail("github_redirect_download_failed")


def redact(value: str) -> str:
    for pattern in REDACTIONS:
        value = pattern.sub("[REDACTED]", value)
    return value


def secure_policy(task_id: str) -> dict:
    if not TASK_ID.fullmatch(task_id):
        fail("task_id_invalid")
    try:
        directory = os.lstat(POLICY_DIRECTORY)
    except OSError:
        fail("policy_directory_unavailable")
    if (
        stat.S_ISLNK(directory.st_mode)
        or not stat.S_ISDIR(directory.st_mode)
        or directory.st_uid != 0
        or directory.st_gid != 0
        or stat.S_IMODE(directory.st_mode) != 0o700
    ):
        fail("policy_directory_invalid")
    path = POLICY_DIRECTORY / f"{task_id}.json"
    try:
        metadata = os.lstat(path)
    except OSError:
        fail("policy_unavailable")
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_size <= 0
        or metadata.st_size > MAX_POLICY_BYTES
    ):
        fail("policy_invalid")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        if opened.st_dev != metadata.st_dev or opened.st_ino != metadata.st_ino:
            fail("policy_changed")
        payload = os.read(descriptor, MAX_POLICY_BYTES + 1)
    finally:
        os.close(descriptor)
    try:
        policy = json.loads(payload.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError):
        fail("policy_json_invalid")
    if (
        not isinstance(policy, dict)
        or policy.get("task_id") != task_id
        or policy.get("base_branch") != "main"
        or task_id not in str(policy.get("branch", ""))
    ):
        fail("policy_identity_invalid")
    return policy


def validated_pr(policy: dict, pr_number: str, head_sha: str) -> dict:
    if not PR_NUMBER.fullmatch(pr_number) or not FULL_SHA.fullmatch(head_sha):
        fail("pr_identity_invalid")
    pull = api_get(f"/repos/{REPOSITORY}/pulls/{pr_number}")
    if not isinstance(pull, dict):
        fail("pull_request_invalid")
    head = pull.get("head") if isinstance(pull.get("head"), dict) else {}
    base = pull.get("base") if isinstance(pull.get("base"), dict) else {}
    head_repository = head.get("repo") if isinstance(head.get("repo"), dict) else {}
    state = pull.get("state")
    merge_commit_sha = pull.get("merge_commit_sha")
    merged = (
        state == "closed"
        and pull.get("merged") is True
        and isinstance(merge_commit_sha, str)
        and FULL_SHA.fullmatch(merge_commit_sha)
    )
    if (
        (state != "open" and not merged)
        or head.get("sha") != head_sha
        or head.get("ref") != policy.get("branch")
        or head_repository.get("full_name") != REPOSITORY
        or base.get("ref") != "main"
        or pull.get("title") != policy.get("pr_title")
    ):
        fail("pull_request_identity_mismatch")
    return pull


def validate_required_checks(head_sha: str) -> None:
    try:
        check_runs = CHECK_RUN_GATE["list_required_check_runs"](
            api_get, repository=REPOSITORY, head_sha=head_sha
        )
        summary = CHECK_RUN_GATE["evaluate_required_check_runs"](
            check_runs, head_sha=head_sha, required_checks=REQUIRED_CHECKS
        )
    except CHECK_RUN_GATE["CheckRunGateError"]:
        fail("required_checks_response_invalid")
    if not summary["passed"]:
        fail("required_checks_not_successful")


def artifact_name(task_id: str, head_sha: str) -> str:
    return f"oripa-preview-images-{task_id}-{head_sha}"


def validated_run(run_id: int) -> dict:
    run = api_get(f"/repos/{REPOSITORY}/actions/runs/{run_id}")
    if not isinstance(run, dict):
        fail("workflow_run_invalid")
    path = str(run.get("path", "")).split("@", 1)[0]
    if (
        run.get("event") != "workflow_dispatch"
        or run.get("status") != "completed"
        or run.get("conclusion") != "success"
        or path != ".github/workflows/preview-image-build.yml"
        or run.get("head_branch") != "main"
    ):
        fail("workflow_run_rejected")
    return run


def list_preview_artifacts(task_id: str, pr_number: str, head_sha: str) -> list[dict]:
    policy = secure_policy(task_id)
    validated_pr(policy, pr_number, head_sha)
    validate_required_checks(head_sha)
    query = urllib.parse.urlencode({"name": artifact_name(task_id, head_sha), "per_page": "100"})
    result = api_get(f"/repos/{REPOSITORY}/actions/artifacts?{query}")
    if not isinstance(result, dict) or not isinstance(result.get("artifacts"), list):
        fail("artifacts_response_invalid")
    output = []
    for artifact in result["artifacts"]:
        if not isinstance(artifact, dict) or artifact.get("expired") is True:
            continue
        workflow_run = artifact.get("workflow_run")
        run_id = workflow_run.get("id") if isinstance(workflow_run, dict) else None
        if not isinstance(run_id, int):
            continue
        validated_run(run_id)
        digest = artifact.get("digest")
        if artifact.get("name") != artifact_name(task_id, head_sha) or not isinstance(digest, str) or not SHA256.fullmatch(digest):
            continue
        output.append(
            {
                "id": artifact.get("id"),
                "name": artifact.get("name"),
                "digest": digest,
                "size_in_bytes": artifact.get("size_in_bytes"),
                "workflow_run_id": run_id,
                "expires_at": artifact.get("expires_at"),
            }
        )
    return output


def validate_destination(task_id: str, value: str) -> Path:
    destination = Path(value)
    if not destination.is_absolute() or ".." in PurePosixPath(value).parts:
        fail("destination_invalid")
    allowed_root = (EVIDENCE_ROOT / task_id / "preview-image-artifacts").resolve()
    resolved = destination.resolve(strict=False)
    if resolved == allowed_root or allowed_root not in resolved.parents or destination.exists():
        fail("destination_invalid")
    allowed_root.mkdir(mode=0o700, parents=True, exist_ok=True)
    metadata = os.lstat(allowed_root)
    if metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) & 0o077:
        fail("destination_root_invalid")
    return destination


def download_to(path: str, destination: Path) -> str:
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, request, file_pointer, code, message, headers, url):
            return None

    access_token = installation_token()
    request = urllib.request.Request(
        API_ROOT + path,
        method="GET",
        headers={
            "Accept": "application/vnd.github+json",
            "Authorization": f"Bearer {access_token}",
            "X-GitHub-Api-Version": API_VERSION,
            "User-Agent": USER_AGENT,
        },
    )
    try:
        urllib.request.build_opener(NoRedirect).open(request, timeout=60)
        fail("artifact_redirect_missing")
    except urllib.error.HTTPError as error:
        if error.code not in {301, 302, 303, 307, 308}:
            error.read()
            fail(f"github_api_http_{error.code}")
        location = error.headers.get("Location")
        if not location or not location.startswith("https://"):
            fail("artifact_redirect_invalid")
    except (urllib.error.URLError, TimeoutError):
        fail("github_api_connection_failed")
    finally:
        access_token = ""

    digest = hashlib.sha256()
    total = 0
    try:
        response_context = urllib.request.urlopen(location, timeout=60)
    except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError):
        fail("artifact_download_failed")
    with response_context as response:
        with destination.open("xb") as target:
            while True:
                chunk = response.read(1024 * 1024)
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_ARTIFACT_BYTES:
                    fail("artifact_too_large")
                digest.update(chunk)
                target.write(chunk)
    return digest.hexdigest()


def safe_extract(source: Path, destination: Path) -> None:
    common = {
        "manifest.json",
        "SHA256SUMS",
        "oripa-v2-api-linux-amd64.docker.tar.zst",
    }
    allowed_sets = (
        common,
        common | {"oripa-v2-admin-linux-amd64.docker.tar.zst"},
    )
    with zipfile.ZipFile(source) as archive:
        files = [item for item in archive.infolist() if not item.is_dir()]
        filenames = {item.filename for item in files}
        if len(files) != len(filenames) or filenames not in allowed_sets:
            fail("artifact_file_set_invalid")
        if sum(item.file_size for item in files) > MAX_ARTIFACT_BYTES:
            fail("artifact_unpacked_too_large")
        for item in files:
            mode = item.external_attr >> 16
            if stat.S_ISLNK(mode) or PurePosixPath(item.filename).name != item.filename:
                fail("artifact_member_invalid")
            target = destination / item.filename
            with archive.open(item) as source_stream, target.open("xb") as target_stream:
                while chunk := source_stream.read(1024 * 1024):
                    target_stream.write(chunk)


def require_outer_digest(github_digest: str, actual_digest: str) -> None:
    match = SHA256.fullmatch(github_digest)
    if not match or match.group(1) != actual_digest:
        fail("outer_artifact_digest_mismatch")


def download_preview_artifact(
    task_id: str,
    pr_number: str,
    head_sha: str,
    artifact_id: str,
    destination_value: str,
) -> dict:
    policy = secure_policy(task_id)
    validated_pr(policy, pr_number, head_sha)
    validate_required_checks(head_sha)
    if not ARTIFACT_ID.fullmatch(artifact_id):
        fail("artifact_id_invalid")
    destination = validate_destination(task_id, destination_value)
    artifact = api_get(f"/repos/{REPOSITORY}/actions/artifacts/{artifact_id}")
    workflow_run = artifact.get("workflow_run") if isinstance(artifact, dict) else None
    run_id = workflow_run.get("id") if isinstance(workflow_run, dict) else None
    digest = artifact.get("digest") if isinstance(artifact, dict) else None
    if (
        artifact.get("name") != artifact_name(task_id, head_sha)
        or artifact.get("expired") is True
        or not isinstance(run_id, int)
        or not isinstance(digest, str)
        or not SHA256.fullmatch(digest)
    ):
        fail("artifact_identity_mismatch")
    validated_run(run_id)

    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".preview-artifact-", dir=destination.parent) as temporary:
        staging = Path(temporary)
        archive = staging / "github-artifact.zip"
        actual_digest = download_to(
            f"/repos/{REPOSITORY}/actions/artifacts/{artifact_id}/zip", archive
        )
        require_outer_digest(digest, actual_digest)
        payload = staging / "payload"
        payload.mkdir(mode=0o700)
        safe_extract(archive, payload)
        verification = subprocess.run(
            [
                sys.executable,
                str(ARTIFACT_HELPER),
                "verify",
                "--directory",
                str(payload),
                "--task-id",
                task_id,
                "--pr-number",
                pr_number,
                "--source-sha",
                head_sha,
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
        )
        if verification.returncode:
            fail("inner_artifact_verification_failed")
        metadata = {
            "artifact_id": int(artifact_id),
            "artifact_name": artifact["name"],
            "outer_sha256": actual_digest,
            "github_digest": digest,
            "workflow_run_id": run_id,
            "task_id": task_id,
            "pull_request": int(pr_number),
            "source_commit": head_sha,
        }
        (staging / "download-metadata.json").write_bytes(
            (json.dumps(metadata, sort_keys=True, indent=2) + "\n").encode("utf-8")
        )
        os.rename(staging, destination)
    return {**metadata, "directory": str(destination), "payload": str(destination / "payload"), "status": "verified"}


def job_log_errors_operation(job_id: str) -> None:
    if not JOB_ID.fullmatch(job_id):
        fail("job_id_invalid")
    body = api_get_bytes(f"/repos/{REPOSITORY}/actions/jobs/{job_id}/logs")
    lines = body.decode("utf-8", errors="replace").splitlines()
    keywords = ("fail", "error", "mismatch", "exception", "not found")
    selected = set()
    for index, line in enumerate(lines):
        if any(keyword in line.lower() for keyword in keywords):
            selected.update(range(max(0, index - 2), min(len(lines), index + 3)))
    print("\n".join(redact(lines[index]) for index in sorted(selected)[-200:]))


def app_operation() -> None:
    decoded = json.loads(broker_call(["--app-name"]))
    print(json.dumps({"app_name": decoded["app_name"]}, sort_keys=True))


def repositories_operation() -> None:
    decoded = json.loads(broker_call(["--metadata"]))
    allowed = {
        "app_name": decoded.get("app_name"),
        "repository_selection": decoded.get("repository_selection"),
        "repositories": decoded.get("repositories", []),
        "installation_permissions": decoded.get("installation_permissions", {}),
        "issued_token_permissions": decoded.get("issued_token_permissions", {}),
    }
    print(json.dumps(allowed, sort_keys=True))


def repository_operation(path: str) -> None:
    decoded = api_get(path)
    owner = decoded.get("owner") if isinstance(decoded.get("owner"), dict) else {}
    print(
        json.dumps(
            {
                "name": decoded.get("name"),
                "full_name": decoded.get("full_name"),
                "owner": owner.get("login"),
                "visibility": decoded.get("visibility"),
                "private": decoded.get("private"),
                "default_branch": decoded.get("default_branch"),
            },
            sort_keys=True,
        )
    )


def branch_operation(path: str) -> None:
    decoded = api_get(path)
    commit = decoded.get("commit") if isinstance(decoded.get("commit"), dict) else {}
    print(json.dumps({"name": decoded.get("name"), "sha": commit.get("sha"), "protected": decoded.get("protected")}, sort_keys=True))


def main() -> None:
    if len(sys.argv) < 2:
        fail("operation_required")
    operation = sys.argv[1]
    arguments = sys.argv[2:]
    if operation == "job-log-errors":
        if len(arguments) != 1:
            fail("job_log_arguments_invalid")
        job_log_errors_operation(arguments[0])
    elif operation == "preview-artifacts":
        if len(arguments) != 3:
            fail("preview_artifact_arguments_invalid")
        print(json.dumps(list_preview_artifacts(*arguments), sort_keys=True))
    elif operation == "download-preview-artifact":
        if len(arguments) != 5:
            fail("preview_artifact_arguments_invalid")
        print(json.dumps(download_preview_artifact(*arguments), sort_keys=True))
    elif arguments:
        fail("arguments_not_allowed")
    elif operation == "app":
        app_operation()
    elif operation == "installation-repositories":
        repositories_operation()
    elif operation == "repository":
        repository_operation(OPERATIONS[operation])
    elif operation in {"main-branch", "archive-branch"}:
        branch_operation(OPERATIONS[operation])
    else:
        fail("operation_not_allowed")


if __name__ == "__main__":
    try:
        main()
    except (WrapperError, KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
        classification = str(error) if isinstance(error, WrapperError) else "response_invalid"
        print(f"api_wrapper_error:{classification}", file=sys.stderr)
        raise SystemExit(1)
    except Exception:
        print("api_wrapper_error:unexpected_failure", file=sys.stderr)
        raise SystemExit(1)
