class GitWrapperError(Exception):
    pass


def read_policy_file(path):
    try:
        metadata = os.lstat(path)
    except OSError:
        raise GitWrapperError("policy_unavailable")
    if stat.S_ISLNK(metadata.st_mode):
        raise GitWrapperError("policy_symlink_not_allowed")
    if not stat.S_ISREG(metadata.st_mode):
        raise GitWrapperError("policy_not_regular")
    if metadata.st_uid != 0 or metadata.st_gid != 0:
        raise GitWrapperError("policy_owner_invalid")
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        raise GitWrapperError("policy_mode_invalid")
    if metadata.st_size <= 0 or metadata.st_size > MAX_POLICY_BYTES:
        raise GitWrapperError("policy_size_invalid")
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        if opened.st_dev != metadata.st_dev or opened.st_ino != metadata.st_ino:
            raise GitWrapperError("policy_changed")
        content = os.read(descriptor, MAX_POLICY_BYTES + 1)
    finally:
        os.close(descriptor)
    if len(content) > MAX_POLICY_BYTES:
        raise GitWrapperError("policy_size_invalid")
    return content


def validate_policy_directory():
    try:
        metadata = os.lstat(POLICY_DIRECTORY)
    except OSError:
        raise GitWrapperError("policy_directory_unavailable")
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise GitWrapperError("policy_directory_invalid")
    if metadata.st_uid != 0 or metadata.st_gid != 0:
        raise GitWrapperError("policy_directory_owner_invalid")
    if stat.S_IMODE(metadata.st_mode) != 0o700:
        raise GitWrapperError("policy_directory_mode_invalid")


def validate_policy_data(policy, requested_task_id):
    if not isinstance(policy, dict) or set(policy) != REQUIRED_POLICY_KEYS:
        raise GitWrapperError("policy_schema_invalid")
    task_id = policy.get("task_id")
    if task_id != requested_task_id or not TASK_ID_PATTERN.fullmatch(task_id):
        raise GitWrapperError("policy_task_id_invalid")
    for key in ("issue_title", "pr_title"):
        value = policy.get(key)
        if not isinstance(value, str) or task_id not in value or len(value) > 256:
            raise GitWrapperError(f"policy_{key}_invalid")
    branch = policy.get("branch")
    if not isinstance(branch, str) or task_id not in branch:
        raise GitWrapperError("policy_branch_invalid")
    if not branch.startswith(ALLOWED_PREFIXES):
        raise GitWrapperError("policy_branch_prefix_invalid")
    if branch in {"main", "master"} or branch.startswith(("release/", "archive/", "refs/")):
        raise GitWrapperError("policy_protected_ref_rejected")
    if any(character in branch for character in ("+", ":", " ", "\t", "\n", ";", "&", "|", "`", "$")):
        raise GitWrapperError("policy_branch_invalid")
    ref_check = subprocess.run(
        [GIT, "check-ref-format", f"refs/heads/{branch}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if ref_check.returncode != 0:
        raise GitWrapperError("policy_branch_invalid")
    if policy.get("base_branch") not in {"main", "v1/early-release"}:
        raise GitWrapperError("policy_base_branch_invalid")
    if not isinstance(policy.get("base_sha"), str) or not FULL_SHA_PATTERN.fullmatch(policy["base_sha"]):
        raise GitWrapperError("policy_base_sha_invalid")
    if policy.get("risk") not in {"R1", "R2", "R3", "R4"}:
        raise GitWrapperError("policy_risk_invalid")
    try:
        TASK_POLICY_GATE["validate_governance_metadata"](policy)
    except ValueError as error:
        raise GitWrapperError(str(error))
    operations = policy.get("allowed_operations")
    if not isinstance(operations, list) or not operations or len(operations) != len(set(operations)):
        raise GitWrapperError("policy_operations_invalid")
    if any(not isinstance(value, str) or value not in POLICY_OPERATIONS for value in operations):
        raise GitWrapperError("policy_operation_not_allowed")
    paths = policy.get("allowed_paths")
    if not isinstance(paths, list) or not paths or len(paths) != len(set(paths)):
        raise GitWrapperError("policy_paths_invalid")
    for value in paths:
        if not isinstance(value, str) or not value or "\\" in value or "\x00" in value:
            raise GitWrapperError("policy_path_invalid")
        if "*" in value and (not value.endswith("/**") or "*" in value[:-3]):
            raise GitWrapperError("policy_path_invalid")
        parsed = PurePosixPath(value)
        if parsed.is_absolute() or ".." in parsed.parts or str(parsed) != value:
            raise GitWrapperError("policy_path_invalid")
    return policy


def load_policy(task_id):
    if not TASK_ID_PATTERN.fullmatch(task_id):
        raise GitWrapperError("task_id_invalid")
    validate_policy_directory()
    policy_path = POLICY_DIRECTORY / f"{task_id}.json"
    if policy_path.parent != POLICY_DIRECTORY:
        raise GitWrapperError("policy_path_outside_directory")
    content = read_policy_file(policy_path)
    try:
        policy = json.loads(content.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError):
        raise GitWrapperError("policy_json_invalid")
    return validate_policy_data(policy, task_id)


def installation_token():
    result = subprocess.run(
        [BROKER],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
        text=True,
    )
    token = result.stdout.strip()
    if result.returncode != 0 or len(token) < 20:
        raise GitWrapperError("broker_failed")
    return token


def write_askpass(directory):
    path = Path(directory) / "askpass"
    script = """#!/bin/sh
case "$1" in
  *Username*) printf '%s\\n' 'x-access-token' ;;
  *Password*) printf '%s\\n' "$ORIPA_GITHUB_APP_TOKEN" ;;
  *) exit 1 ;;
esac
"""
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o700)
    try:
        os.write(descriptor, script.encode("utf-8"))
    finally:
        os.close(descriptor)
    if stat.S_IMODE(path.stat().st_mode) != 0o700:
        raise GitWrapperError("askpass_mode_invalid")
    return str(path)


def authenticated_environment(token, directory):
    askpass = write_askpass(directory)
    environment = os.environ.copy()
    environment.update({
        "GIT_ASKPASS": askpass,
        "GIT_ASKPASS_REQUIRE": "force",
        "GIT_TERMINAL_PROMPT": "0",
        "ORIPA_GITHUB_APP_TOKEN": token,
        "GIT_CONFIG_COUNT": "3",
        "GIT_CONFIG_KEY_0": "credential.helper",
        "GIT_CONFIG_VALUE_0": "",
        "GIT_CONFIG_KEY_1": "credential.username",
        "GIT_CONFIG_VALUE_1": "x-access-token",
        "GIT_CONFIG_KEY_2": "credential.useHttpPath",
        "GIT_CONFIG_VALUE_2": "true",
    })
    return environment


def run_authenticated_git(arguments, error_classification):
    os.umask(0o077)
    token = installation_token()
    temporary_directory = tempfile.mkdtemp(prefix="oripa-github-app-git-")
    try:
        os.chmod(temporary_directory, 0o700)
        environment = authenticated_environment(token, temporary_directory)
        result = subprocess.run(
            [GIT] + arguments,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
            text=True,
            env=environment,
        )
        if result.returncode != 0:
            raise GitWrapperError(error_classification)
        return result.stdout
    finally:
        token = ""
        shutil.rmtree(temporary_directory)


def run_local_git(arguments, error_classification, text=True):
    result = subprocess.run(
        [GIT, "-C", REPOSITORY_ROOT] + arguments,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
        text=text,
    )
    if result.returncode != 0:
        raise GitWrapperError(error_classification)
    return result.stdout


def validate_commit_sha(value, classification):
    if not isinstance(value, str) or not FULL_SHA_PATTERN.fullmatch(value):
        raise GitWrapperError(f"{classification}_full_sha_required")
    object_type = run_local_git(["cat-file", "-t", value], f"{classification}_object_missing").strip()
    if object_type != "commit":
        raise GitWrapperError(f"{classification}_not_commit")


def is_ancestor(ancestor, descendant):
    result = subprocess.run(
        [GIT, "-C", REPOSITORY_ROOT, "merge-base", "--is-ancestor", ancestor, descendant],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode == 0:
        return True
    if result.returncode == 1:
        return False
    raise GitWrapperError("commit_ancestry_check_failed")


def changed_paths(older_sha, newer_sha):
    output = run_local_git(
        ["diff", "--name-only", "-z", older_sha, newer_sha],
        "changed_path_check_failed",
        text=False,
    )
    return {entry.decode("utf-8") for entry in output.split(b"\0") if entry}


def policy_path_allowed(path, allowed_paths):
    for allowed in allowed_paths:
        if path == allowed:
            return True
        if allowed.endswith("/**") and path.startswith(f"{allowed[:-3]}/"):
            return True
    return False


def submodule_paths(commit_sha):
    output = run_local_git(["ls-tree", "-r", "-z", commit_sha], "submodule_check_failed", text=False)
    paths = set()
    for entry in output.split(b"\0"):
        if not entry:
            continue
        metadata, path = entry.split(b"\t", 1)
        if metadata.split(b" ", 1)[0] == b"160000":
            paths.add(path.decode("utf-8"))
    return paths


def object_exists(commit_sha, path):
    result = subprocess.run(
        [GIT, "-C", REPOSITORY_ROOT, "cat-file", "-e", f"{commit_sha}:{path}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def validate_commit_tree(policy, expected_remote_sha, new_local_sha):
    allowed_paths = policy["allowed_paths"]
    incremental_paths = changed_paths(expected_remote_sha, new_local_sha)
    cumulative_paths = changed_paths(policy["base_sha"], new_local_sha)
    if not incremental_paths or not all(
        policy_path_allowed(path, allowed_paths) for path in incremental_paths
    ):
        raise GitWrapperError("incremental_changed_paths_not_allowed")
    if not cumulative_paths or not all(
        policy_path_allowed(path, allowed_paths) for path in cumulative_paths
    ):
        raise GitWrapperError("task_changed_paths_not_allowed")
    if submodule_paths(new_local_sha) - submodule_paths(policy["base_sha"]):
        raise GitWrapperError("new_submodule_rejected")
    for path in cumulative_paths:
        lowered = path.lower()
        documented_example = lowered.endswith(
            (".md", ".example.json", ".example.yaml", ".example.yml", ".template", ".sample")
        )
        if (
            lowered.startswith(".env")
            or lowered.endswith((".pem", ".key", ".p12", ".pfx"))
            or (
                any(part in lowered for part in ("credential", "private-key", "id_rsa"))
                and not documented_example
            )
        ):
            raise GitWrapperError("sensitive_path_rejected")
        if not object_exists(new_local_sha, path):
            continue
        content = run_local_git(["show", f"{new_local_sha}:{path}"], "changed_file_read_failed", text=False)
        if any(pattern.search(content) for pattern in HIGH_CONFIDENCE_SECRET_PATTERNS):
            raise GitWrapperError("secret_candidate_rejected")


def validate_policy_branch(policy, branch):
    if branch != policy["branch"]:
        raise GitWrapperError("task_branch_not_allowed")
    if branch in {"main", "master"} or branch.startswith(("release/", "archive/", "refs/")):
        raise GitWrapperError("protected_ref_rejected")


def public_remote_branch_sha(policy):
    remote_ref = f"refs/heads/{policy['branch']}"
    result = subprocess.run(
        [GIT, "ls-remote", REPOSITORY_URL, remote_ref],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
        text=True,
    )
    if result.returncode != 0:
        raise GitWrapperError("remote_branch_check_failed")
    parts = result.stdout.strip().split()
    if len(parts) != 2 or parts[1] != remote_ref or not FULL_SHA_PATTERN.fullmatch(parts[0]):
        raise GitWrapperError("remote_branch_missing_or_invalid")
    return parts[0]


def public_main_sha():
    output = run_authenticated_git(
        ["ls-remote", REPOSITORY_URL, "refs/heads/main"],
        "main_remote_check_failed",
    ).strip()
    parts = output.split()
    if len(parts) != 2 or parts[1] != "refs/heads/main" or not FULL_SHA_PATTERN.fullmatch(parts[0]):
        raise GitWrapperError("main_remote_invalid")
    return parts[0]


def commit_parents(commit_sha):
    output = run_local_git(
        ["rev-list", "--parents", "-n", "1", commit_sha],
        "candidate_parent_read_failed",
    ).strip().split()
    if not output or output[0] != commit_sha or any(
        not FULL_SHA_PATTERN.fullmatch(value) for value in output
    ):
        raise GitWrapperError("candidate_parent_read_failed")
    return output[1:]


def tree_blob(commit_sha, path):
    result = subprocess.run(
        [GIT, "-C", REPOSITORY_ROOT, "rev-parse", f"{commit_sha}:{path}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
        text=True,
    )
    if result.returncode:
        return None
    value = result.stdout.strip()
    if not re.fullmatch(r"[0-9a-f]{40}", value):
        raise GitWrapperError("candidate_blob_invalid")
    return value


def merge_tree(task_head, base_sha):
    result = subprocess.run(
        [GIT, "-C", REPOSITORY_ROOT, "merge-tree", "--write-tree", task_head, base_sha],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
        text=True,
    )
    if result.returncode not in {0, 1}:
        raise GitWrapperError("merge_tree_failed")
    lines = result.stdout.splitlines()
    if not lines or not FULL_SHA_PATTERN.fullmatch(lines[0]):
        raise GitWrapperError("merge_tree_invalid")
    conflicts = []
    for line in lines:
        if not line.startswith("CONFLICT "):
            continue
        match = re.fullmatch(r"CONFLICT \([^)]*\): .* in (.+)", line)
        if not match:
            raise GitWrapperError("merge_tree_invalid")
        conflicts.append(match.group(1))
    if len(conflicts) != len(set(conflicts)):
        raise GitWrapperError("merge_tree_invalid")
    return lines[0], conflicts


def validate_sync_candidate(policy, task_head, base_sha, candidate_sha):
    tree_sha, conflict_paths = merge_tree(task_head, base_sha)
    if not conflict_paths:
        raise GitWrapperError("sync_conflict_required")
    net_changed_paths = sorted(changed_paths(base_sha, candidate_sha))
    automatic_merge_mismatches = sorted(
        changed_paths(tree_sha, candidate_sha) - set(conflict_paths)
    )
    unresolved_conflict_paths = []
    for path in net_changed_paths:
        blob = tree_blob(candidate_sha, path)
        if blob is None:
            continue
        content = run_local_git(
            ["show", f"{candidate_sha}:{path}"],
            "candidate_blob_read_failed",
            text=False,
        )
        if BASE_SYNC_GATE["contains_unresolved_markers"](content):
            unresolved_conflict_paths.append(path)
    resolved_blobs = {
        path: (
            tree_blob(candidate_sha, path),
            tree_blob(task_head, path),
            tree_blob(base_sha, path),
        )
        for path in conflict_paths
    }
    try:
        BASE_SYNC_GATE["validate_candidate"](
            task_head=task_head,
            base_sha=base_sha,
            candidate_sha=candidate_sha,
            parents=commit_parents(candidate_sha),
            net_changed_paths=net_changed_paths,
            conflict_paths=conflict_paths,
            automatic_merge_mismatches=automatic_merge_mismatches,
            unresolved_conflict_paths=unresolved_conflict_paths,
            resolved_blobs=resolved_blobs,
            allowed_paths=policy["allowed_paths"],
        )
    except BASE_SYNC_GATE["TaskBranchBaseSyncError"] as error:
        raise GitWrapperError(str(error)) from error
    if submodule_paths(candidate_sha) - submodule_paths(base_sha):
        raise GitWrapperError("new_submodule_rejected")
    for path in net_changed_paths:
        lowered = path.lower()
        documented_example = lowered.endswith(
            (".md", ".example.json", ".example.yaml", ".example.yml", ".template", ".sample")
        )
        if (
            lowered.startswith(".env")
            or lowered.endswith((".pem", ".key", ".p12", ".pfx"))
            or (
                any(part in lowered for part in ("credential", "private-key", "id_rsa"))
                and not documented_example
            )
        ):
            raise GitWrapperError("sensitive_path_rejected")
        blob = tree_blob(candidate_sha, path)
        if blob is None:
            continue
        content = run_local_git(
            ["show", f"{candidate_sha}:{path}"],
            "changed_file_read_failed",
            text=False,
        )
        if any(pattern.search(content) for pattern in HIGH_CONFIDENCE_SECRET_PATTERNS):
            raise GitWrapperError("secret_candidate_rejected")
    return {"conflict_paths": sorted(conflict_paths), "net_changed_paths": net_changed_paths}


def require_operation(policy, operation):
    if operation not in GIT_OPERATIONS or operation not in policy["allowed_operations"]:
        raise GitWrapperError("operation_not_allowed")


def push_new_branch(policy, arguments):
    if len(arguments) != 2:
        raise GitWrapperError("push_arguments_invalid")
    branch, source_sha = arguments
    validate_policy_branch(policy, branch)
    if source_sha != policy["base_sha"]:
        raise GitWrapperError("source_commit_not_allowed")
    validate_commit_sha(source_sha, "source_commit")
    remote_ref = f"refs/heads/{branch}"
    existing = run_authenticated_git(["ls-remote", REPOSITORY_URL, remote_ref], "remote_check_failed").strip()
    if existing:
        parts = existing.split()
        if len(parts) != 2 or parts[1] != remote_ref or parts[0] != source_sha:
            raise GitWrapperError("remote_branch_conflict")
        print(json.dumps({"branch": branch, "remote_sha": parts[0], "status": "existing"}, sort_keys=True))
        return
    run_authenticated_git(
        ["-C", REPOSITORY_ROOT, "push", "--porcelain", REPOSITORY_URL, f"{source_sha}:{remote_ref}"],
        "git_push_new_branch_failed",
    )
    if public_remote_branch_sha(policy) != source_sha:
        raise GitWrapperError("git_remote_branch_verify_mismatch")
    print(json.dumps({"branch": branch, "remote_sha": source_sha, "status": "created"}, sort_keys=True))


def create_base_branch(policy, arguments):
    if len(arguments) != 2:
        raise GitWrapperError("base_branch_arguments_invalid")
    branch, source_sha = arguments
    if branch != "v1/early-release" or branch != policy["base_branch"]:
        raise GitWrapperError("base_branch_not_allowed")
    if source_sha != policy["base_sha"]:
        raise GitWrapperError("source_commit_not_allowed")
    validate_commit_sha(source_sha, "source_commit")
    remote_ref = f"refs/heads/{branch}"
    existing = run_authenticated_git(
        ["ls-remote", REPOSITORY_URL, remote_ref],
        "base_branch_remote_check_failed",
    ).strip()
    if existing:
        parts = existing.split()
        if len(parts) != 2 or parts[1] != remote_ref or parts[0] != source_sha:
            raise GitWrapperError("base_branch_conflict")
        print(json.dumps({"branch": branch, "remote_sha": source_sha, "status": "existing"}, sort_keys=True))
        return
    run_authenticated_git(
        ["-C", REPOSITORY_ROOT, "push", "--porcelain", REPOSITORY_URL, f"{source_sha}:{remote_ref}"],
        "git_create_base_branch_failed",
    )
    verified = run_authenticated_git(
        ["ls-remote", REPOSITORY_URL, remote_ref],
        "base_branch_verify_failed",
    ).strip().split()
    if len(verified) != 2 or verified[0] != source_sha or verified[1] != remote_ref:
        raise GitWrapperError("base_branch_verify_mismatch")
    print(json.dumps({"branch": branch, "remote_sha": source_sha, "status": "created"}, sort_keys=True))


def push_task_branch(policy, arguments):
    if len(arguments) != 3:
        raise GitWrapperError("task_push_arguments_invalid")
    branch, expected_remote_sha, new_local_sha = arguments
    validate_policy_branch(policy, branch)
    validate_commit_sha(policy["base_sha"], "policy_base")
    validate_commit_sha(expected_remote_sha, "expected_remote")
    validate_commit_sha(new_local_sha, "new_local")
    if expected_remote_sha == new_local_sha:
        raise GitWrapperError("task_branch_no_update")
    if not is_ancestor(policy["base_sha"], expected_remote_sha):
        raise GitWrapperError("expected_remote_not_on_task_base")
    if not is_ancestor(expected_remote_sha, new_local_sha):
        raise GitWrapperError("non_fast_forward_rejected")
    if run_local_git(["merge-base", expected_remote_sha, new_local_sha], "merge_base_check_failed").strip() != expected_remote_sha:
        raise GitWrapperError("merge_base_mismatch")
    validate_commit_tree(policy, expected_remote_sha, new_local_sha)
    if public_remote_branch_sha(policy) != expected_remote_sha:
        raise GitWrapperError("REMOTE_BRANCH_CHANGED")
    remote_ref = f"refs/heads/{branch}"
    run_authenticated_git(
        ["-C", REPOSITORY_ROOT, "push", "--porcelain", REPOSITORY_URL, f"{new_local_sha}:{remote_ref}"],
        "git_push_task_branch_failed",
    )
    if public_remote_branch_sha(policy) != new_local_sha:
        raise GitWrapperError("git_task_branch_verify_mismatch")
    print(json.dumps({"branch": branch, "remote_sha": new_local_sha, "status": "updated"}, sort_keys=True))


def sync_task_branch_base(policy, arguments):
    if len(arguments) != 3:
        raise GitWrapperError("sync_arguments_invalid")
    expected_task_head, expected_base_sha, candidate_sha = arguments
    validate_policy_branch(policy, policy["branch"])
    validate_commit_sha(expected_task_head, "expected_task_head")
    validate_commit_sha(expected_base_sha, "expected_base")
    validate_commit_sha(candidate_sha, "candidate")
    remote_task_head = public_remote_branch_sha(policy)
    remote_base_sha = public_main_sha()
    try:
        BASE_SYNC_GATE["validate_current_refs"](
            task_head=expected_task_head,
            base_sha=expected_base_sha,
            remote_task_head=remote_task_head,
            remote_base_sha=remote_base_sha,
        )
    except BASE_SYNC_GATE["TaskBranchBaseSyncError"] as error:
        raise GitWrapperError(str(error)) from error
    if not is_ancestor(expected_task_head, candidate_sha):
        raise GitWrapperError("sync_non_fast_forward_rejected")
    validation = validate_sync_candidate(
        policy, expected_task_head, expected_base_sha, candidate_sha
    )
    if public_remote_branch_sha(policy) != expected_task_head:
        raise GitWrapperError("REMOTE_BRANCH_CHANGED")
    if public_main_sha() != expected_base_sha:
        raise GitWrapperError("sync_base_changed")
    remote_ref = f"refs/heads/{policy['branch']}"
    run_authenticated_git(
        ["-C", REPOSITORY_ROOT, "push", "--porcelain", REPOSITORY_URL, f"{candidate_sha}:{remote_ref}"],
        "git_sync_task_branch_failed",
    )
    if public_remote_branch_sha(policy) != candidate_sha:
        raise GitWrapperError("git_sync_task_branch_verify_mismatch")
    print(
        json.dumps(
            {
                "branch": policy["branch"],
                "remote_sha": candidate_sha,
                "base_sha": expected_base_sha,
                **validation,
                "status": "synced",
            },
            sort_keys=True,
        )
    )


def ls_remote():
    output = run_authenticated_git(["ls-remote", REPOSITORY_URL] + REFS, "git_ls_remote_failed")
    sys.stdout.write(output)


def main():
    if sys.argv[1:] == ["ls-remote"]:
        ls_remote()
        return
    if len(sys.argv) < 3:
        raise GitWrapperError("task_and_operation_required")
    task_id, operation = sys.argv[1:3]
    arguments = sys.argv[3:]
    policy = load_policy(task_id)
    require_operation(policy, operation)
    if operation == "create-base-branch":
        create_base_branch(policy, arguments)
    elif operation == "push-new-branch":
        push_new_branch(policy, arguments)
    elif operation == "push-task-branch":
        push_task_branch(policy, arguments)
    elif operation == "sync-task-branch-base":
        sync_task_branch_base(policy, arguments)
    else:
        raise GitWrapperError("operation_not_allowed")


if __name__ == "__main__":
    try:
        main()
    except GitWrapperError as error:
        print(f"git_wrapper_error:{error}", file=sys.stderr)
        sys.exit(1)
    except Exception:
        print("git_wrapper_error:unexpected_failure", file=sys.stderr)
        sys.exit(1)
